import java.util.Scanner;

 public class Canteen {

 public static void main(String[] args) {

 Scanner input = new Scanner(System.in);


 double[] prices = {50, 35, 40, 60, 30};


 String[] foodNames = {
 "Burger",
 "Fries",
 "Chicken",
 "Spaghetti",
 "Ice Cream"
 };


 int totalQuantity = 0;
 double totalAmount = 0;
 double deduction = 0;
 double finalAmount = 0;

 char student = 'N';
 char orderAgain = 'Y';

 // start ordering
 while (orderAgain == 'Y' || orderAgain == 'y') {

 // display ang Menu
 System.out.println();
 System.out.println("===== CANTEEN MENU =====");
 System.out.println("1. Burger - $50");
 System.out.println("2. Fries - $35");
 System.out.println("3. Chicken - $40");
 System.out.println("4. Spaghetti - $60");
 System.out.println("5. Ice Cream - $30");

 System.out.print("\nEnter item number: ");
 int itemNumber = input.nextInt();

 System.out.print("Enter quantity (1-10): ");
 int quantity = input.nextInt();

 System.out.print("Are you a student? (Y/N): ");
 student = input.next().charAt(0);

 // check the item number
 if (itemNumber < 1 || itemNumber > 5) {

 System.out.println("\nInvalid item number!");
 System.out.println("Please choose an item from 1 to 5.");

 System.out.print("\nDo you want to order again? (Y/N): ");
 orderAgain = input.next().charAt(0);

 continue;
 }

 // check quantity in 1 to 10
 if (quantity < 1 || quantity > 10) {

 System.out.println("\nInvalid quantity!");
 System.out.println("Quantity must be between 1 and 10.");

 System.out.print("\nDo you want to order again? (Y/N): ");
 orderAgain = input.next().charAt(0);

 continue;
 }

 // check student or not
 if (student != 'Y' && student != 'y'
 && student != 'N' && student != 'n') {

 System.out.println("\nInvalid student status!");
 System.out.println("Please enter Y or N.");

 System.out.print("\nDo you want to order again? (Y/N): ");
 orderAgain = input.next().charAt(0);

 continue;
 }

 // calculate kung magkano ang order amount
 double orderAmount = prices[itemNumber - 1] * quantity;

 // add to lahat ng totals
 totalQuantity += quantity;
 totalAmount += orderAmount;

 // display orders details of the program
 System.out.println("\n===== ORDER DETAILS =====");
 System.out.println("Item: " + foodNames[itemNumber - 1]);
 System.out.println("Quantity: " + quantity);
 System.out.println("Order amount: $" + orderAmount);

 // ask if customer wants another order
 System.out.print("\nDo you want to order again? (Y/N): ");
 orderAgain = input.next().charAt(0);
 }

 // calculate deduction
 if ((student == 'Y' || student == 'y') && totalAmount >= 500) {

 deduction = totalAmount * 0.15;

 } else if (student == 'Y' || student == 'y') {

 deduction = totalAmount * 0.10;

 } else if (totalAmount >= 500) {

 deduction = totalAmount * 0.05;
 }

 // calculate finalamount
 finalAmount = totalAmount - deduction;

 // display overalltotal bill
 System.out.println();
 System.out.println("===== FINAL BILL =====");
 System.out.println("Total quantity: " + totalQuantity);
 System.out.println("Total amount before deductions: $" + totalAmount);
 System.out.println("Total deduction: $" + deduction);
 System.out.println("Final amount to pay: $" + finalAmount);

 System.out.println();
 System.out.println("Thank you for ordering!");
 System.out.println();
 }
 }

